# Copy to .env to change defaults. Everything here is for local development only.
# The app refuses to start without FESTRUSH_SECRET_KEY (16+ characters).
FESTRUSH_SECRET_KEY=local-development-only-secret-change-me
FESTRUSH_DATABASE_URL=postgresql://festrush:festrush-dev@localhost:5440/festrush
FESTRUSH_DEBUG=false
# Set to true when serving over HTTPS.
FESTRUSH_COOKIE_SECURE=false
# Password for the demo01..demo05 accounts created by `festrush seed`.
FESTRUSH_DEMO_PASSWORD=festrush-demo

# docker compose
POSTGRES_PASSWORD=festrush-dev
POSTGRES_PORT=5440
APP_PORT=8080
